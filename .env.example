# KITOFLUX.AI Core Configuration

# LLM Providers (Choose 'groq' or 'openai')
KFX_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Models
KFX_GROQ_MODEL=llama-3.1-70b-versatile
KFX_OPENAI_MODEL=gpt-4o-mini

# Speech-to-Text
KFX_STT_MODE=webspeech

# Humanized Autotyper
KFX_TYPING_WPM=85
KFX_TYPO_RATE=0.015

# Stealth & Display
KFX_STEALTH_EXCLUDE_CAPTURE=true
